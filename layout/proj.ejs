<%- include('includes/custom/head_customized') %>

<div id="proj">
  <% if (page.cover) { %>
    <div class="project-banner" style="background-image: url('<%= url_for(page.cover) %>')">
      <% if (page.title_overlay) { %>
        <div class="title-overlay">
          <h1 class="project-title"><%= page.title %></h1>
          <% if (page.subtitle) { %>
            <h2 class="project-subtitle"><%= page.subtitle %></h2>
          <% } %>
        </div>
      <% } else { %>
        <h1 class="project-title"><%= page.title %></h1>
      <% } %>
    </div>
  <% } %>
  
  <article class="project-content">
    <%- page.content %>
  </article>
</div>

<style>

.project-banner {
  width: 100%;
  height: 900px;
  background-size: cover;
  background-position: center;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.project-banner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.project-title {
  color: #1a45c8;
  font-size: 6em;
  position: relative;
  z-index: 1;
  font-family: 'Josefin Sans', sans-serif;
  font-weight: 700;
}

.project-subtitle {
  color: #1a45c8;
  font-size: 2em;
  position: relative;
  z-index: 1;
  font-family: 'Josefin Sans', sans-serif;
  font-weight: 500;
}

.project-content {
  color: #1a45c8;
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 20px;
  font-family: 'Montserrat', sans-serif;
  font-weight: 400;
  line-height: 1.8;
}

.project-content h2,
.project-content h3,
.project-content h4 {
  font-family: 'Josefin Sans', sans-serif;
  font-weight: 500;
  margin: 2em 0 1em;
}

.project-content p {
  font-family: 'Montserrat', sans-serif;
  font-weight: 400;
  line-height: 1.8;
  margin: 1em 0;
}

.project-content img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 2em auto;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}

.project-content img.visible {
  opacity: 1;
  transform: translateY(0);
}

.title-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(1px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
      const images = document.querySelectorAll(".project-content img");

      let observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
              if (entry.isIntersecting) {
                  entry.target.classList.add("visible");
              } else {
                  entry.target.classList.remove("visible");
              }
          });
      }, { threshold: 0.3 });

      images.forEach(img => observer.observe(img));
  });
</script>
