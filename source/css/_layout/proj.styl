#proj-container
  display: flex
  min-height: 100vh
  position: relative
  
.proj-text-column
  width: 30%
  position: sticky
  top: 0
  height: 100vh
  padding: 2rem
  overflow-y: auto
  
.proj-image-column
  width: 70%
  
.proj-image-section
  height: 100vh
  position: relative
  opacity: 0
  transition: opacity 0.5s ease-in-out
  
  img
    width: 100%
    height: 100%
    object-fit: cover
    
  &.active
    opacity: 1